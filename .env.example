GROQ_API_KEY=your_groq_api_key_here

NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=newsscrapedatabase

# Company MySQL (read-only). Leave unset to run without it.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=readonly_user
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=company_db

# Auth — every endpoint validates its session against company-service.
# AUTH_ENABLED=false serves everything unauthenticated: local development only.
AUTH_ENABLED=true
AUTH_SERVICE_BASE_URL=https://qa.done.deals
AUTH_VALIDATE_PATH=/api/company-service/v1/internal/token/validate
AUTH_TIMEOUT_SECONDS=5
AUTH_CACHE_TTL_SECONDS=30       # 0 to validate on every request; a revoked
                                # session stays usable for at most this long
AUTH_TRUST_PROXY_HEADERS=false  # true only when a proxy we control sets X-Forwarded-For

# API server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false                            # dev only — never true in production
CORS_ALLOWED_ORIGINS=http://localhost:3000  # comma-separated

# The scrape/extraction timers run inside the API process and hold no
# cross-process lock. Exactly one instance may have this true; every extra
# API replica must set it false or all work is duplicated.
SCHEDULER_ENABLED=true

# Logging — stdout always, plus this rotating file ("none" for stdout only).
LOG_LEVEL=INFO
LOG_FILE=news_agent.log
LOG_MAX_BYTES=52428800
LOG_BACKUP_COUNT=5
